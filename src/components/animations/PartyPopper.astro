---
import { Icon } from "astro-icon/components";
---

<div class="party-popper-card" id="party-popper-card">
	<!-- Full screen / Card Confetti Canvas -->
	<canvas id="confetti-canvas" class="confetti-canvas" aria-hidden="true"></canvas>

	<div class="celebration-hero">
		<!-- Animated Party Popper Illustration -->
		<div class="popper-visual-wrapper">
			<div class="popper-glow" aria-hidden="true"></div>

			<!-- Dynamic Sparkles floating around -->
			<div class="floating-sparkles" aria-hidden="true">
				<span class="spark-star s1">✦</span>
				<span class="spark-star s2">★</span>
				<span class="spark-star s3">✦</span>
				<span class="spark-star s4">✧</span>
				<span class="spark-star s5">★</span>
			</div>

			<!-- Stylized Party Popper SVG Icon -->
			<button
				type="button"
				id="popper-interactive-btn"
				class="popper-interactive-btn"
				aria-label="Interactive Party Popper. Click to shoot confetti!"
				title="Click to shoot a confetti blast!"
			>
				<div class="popper-floating-reactions" id="popper-reactions" aria-hidden="true"></div>

				<svg class="popper-svg" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<defs>
						<linearGradient id="coneGrad" x1="0%" y1="100%" x2="100%" y2="0%">
							<stop offset="0%" stop-color="#b25329" />
							<stop offset="50%" stop-color="#d97736" />
							<stop offset="100%" stop-color="#f5a65b" />
						</linearGradient>
						<linearGradient id="coneRimGrad" x1="0%" y1="0%" x2="100%" y2="100%">
							<stop offset="0%" stop-color="#ffe6a3" />
							<stop offset="100%" stop-color="#e5b84c" />
						</linearGradient>
						<linearGradient id="streamerPink" x1="0%" y1="0%" x2="100%" y2="100%">
							<stop offset="0%" stop-color="#f27d92" />
							<stop offset="100%" stop-color="#d64062" />
						</linearGradient>
						<linearGradient id="streamerGreen" x1="0%" y1="0%" x2="100%" y2="100%">
							<stop offset="0%" stop-color="#7ec89b" />
							<stop offset="100%" stop-color="#3d8b5c" />
						</linearGradient>
						<linearGradient id="streamerBlue" x1="0%" y1="0%" x2="100%" y2="100%">
							<stop offset="0%" stop-color="#76b3e8" />
							<stop offset="100%" stop-color="#3a7ec2" />
						</linearGradient>
					</defs>

					<!-- Burst explosion lines -->
					<g class="popper-burst-lines">
						<line x1="88" y1="72" x2="128" y2="36" stroke="hsl(var(--theme-accent))" stroke-width="2.5" stroke-linecap="round" class="burst-line b1" />
						<line x1="94" y1="80" x2="145" y2="60" stroke="#e5a93c" stroke-width="2" stroke-linecap="round" class="burst-line b2" />
						<line x1="78" y1="62" x2="104" y2="18" stroke="#4a7c59" stroke-width="2" stroke-linecap="round" class="burst-line b3" />
						<line x1="68" y1="58" x2="72" y2="12" stroke="#d64062" stroke-width="2" stroke-linecap="round" class="burst-line b4" />
						<line x1="82" y1="88" x2="135" y2="105" stroke="#3a7ec2" stroke-width="1.8" stroke-linecap="round" class="burst-line b5" />
					</g>

					<!-- Exploding Streamers & Spirals -->
					<g class="exploding-streamers">
						<!-- Curled Ribbon 1 (Pink) -->
						<path
							d="M 85 70 Q 110 40, 120 48 T 138 25"
							stroke="url(#streamerPink)"
							stroke-width="3"
							stroke-linecap="round"
							fill="none"
							class="streamer-ribbon r1"
						/>
						<!-- Curled Ribbon 2 (Green) -->
						<path
							d="M 75 60 Q 90 28, 80 20 T 95 6"
							stroke="url(#streamerGreen)"
							stroke-width="3.5"
							stroke-linecap="round"
							fill="none"
							class="streamer-ribbon r2"
						/>
						<!-- Curled Ribbon 3 (Gold) -->
						<path
							d="M 92 78 Q 120 70, 132 82 T 150 72"
							stroke="url(#coneRimGrad)"
							stroke-width="3"
							stroke-linecap="round"
							fill="none"
							class="streamer-ribbon r3"
						/>
					</g>

					<!-- Floating Confetti Bits -->
					<g class="popper-confetti-bits">
						<!-- Golden Star -->
						<path
							d="M 125 18 L 127 23 L 132 24 L 128 27 L 129 32 L 125 29 L 121 32 L 122 27 L 118 24 L 123 23 Z"
							fill="#f4c042"
							class="confetti-bit c-star"
						/>
						<!-- Pink diamond -->
						<polygon points="106,32 112,38 106,44 100,38" fill="#e85d75" class="confetti-bit c1" />
						<!-- Blue circle -->
						<circle cx="140" cy="46" r="4.5" fill="#4a90e2" class="confetti-bit c2" />
						<!-- Green rectangle -->
						<rect x="74" y="24" width="7" height="12" rx="1.5" transform="rotate(25 74 24)" fill="#52b788" class="confetti-bit c3" />
						<!-- Honey square -->
						<rect x="110" y="60" width="8" height="8" rx="1.5" transform="rotate(-18 110 60)" fill="#e5a93c" class="confetti-bit c4" />
						<!-- Coral circle -->
						<circle cx="92" cy="38" r="3.5" fill="#d9534f" class="confetti-bit c5" />
						<!-- Lavender triangle -->
						<polygon points="128,78 136,84 126,90" fill="#9d72cf" class="confetti-bit c6" />
					</g>

					<!-- Party Popper Cone Body -->
					<g class="popper-cone-group">
						<!-- Cone triangular body -->
						<path
							d="M 32 138 L 84 86 C 88 82, 94 88, 90 92 L 38 144 C 34 148, 28 142, 32 138 Z"
							fill="url(#coneGrad)"
							stroke="#7c3413"
							stroke-width="2.5"
							stroke-linejoin="round"
						/>
						<!-- Popper Stripes -->
						<path d="M 44 126 L 68 102" stroke="#ffe6a3" stroke-width="3" stroke-linecap="round" opacity="0.9" />
						<path d="M 54 136 L 78 112" stroke="#d64062" stroke-width="3" stroke-linecap="round" opacity="0.9" />
						<path d="M 38 120 L 52 106" stroke="#4a7c59" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />

						<!-- Cone Open Mouth Oval Rim -->
						<ellipse
							cx="87"
							cy="89"
							rx="14"
							ry="7"
							transform="rotate(-45 87 89)"
							fill="url(#coneRimGrad)"
							stroke="#7c3413"
							stroke-width="2"
						/>
						<!-- Cone interior depth shadow -->
						<ellipse
							cx="88"
							cy="88"
							rx="11"
							ry="5"
							transform="rotate(-45 88 88)"
							fill="#692b0f"
						/>
					</g>
				</svg>
			</button>
		</div>

		<!-- Celebration Title & Interactive Popper Launcher -->
		<div class="celebration-content">
			<div class="celebration-badge">
				<Icon name="lucide:party-popper" class="celebration-badge-icon" aria-hidden="true" />
				<span>Official Subscriber Confirmed</span>
			</div>
			<h2 class="celebration-heading">Woohoo! You're in! 🎉</h2>
			<p class="celebration-desc">
				Thank you for verifying your email! Your seat is secured, the confetti is flying, and the very next story will arrive right in your inbox.
			</p>

			<!-- Interactive Popper Trigger Button -->
			<div class="celebration-actions-row">
				<button type="button" id="launch-confetti-btn" class="pop-confetti-btn">
					<Icon name="lucide:sparkles" class="btn-spark-icon" aria-hidden="true" />
					<span id="pop-btn-label">Pop the celebration popper! 🎉</span>
				</button>
				<span class="celebration-counter" id="celebration-counter">Celebrated 1 time! 🥳</span>
			</div>
		</div>
	</div>
</div>

<script>
	// Confetti Cannon Physics & Engine
	function setupPartyCelebration() {
		const canvas = document.getElementById("confetti-canvas");
		const popperBtn = document.getElementById("popper-interactive-btn");
		const launchBtn = document.getElementById("launch-confetti-btn");
		const counterLabel = document.getElementById("celebration-counter");
		const reactionsContainer = document.getElementById("popper-reactions");
		const card = document.getElementById("party-popper-card");

		if (!canvas) return;

		const ctx = canvas.getContext("2d");
		if (!ctx) return;

		let width = (canvas.width = canvas.parentElement ? canvas.parentElement.offsetWidth : 700);
		let height = (canvas.height = canvas.parentElement ? canvas.parentElement.offsetHeight : 280);

		function resize() {
			if (!canvas || !canvas.parentElement) return;
			width = canvas.width = canvas.parentElement.offsetWidth;
			height = canvas.height = canvas.parentElement.offsetHeight;
		}

		window.addEventListener("resize", resize);

		// Colors matching warm blog palette + festive accents
		const colors = [
			"#c85a32", // Warm terracotta
			"#e5a93c", // Honey gold
			"#4a7c59", // Sage forest
			"#3a7ec2", // Soft dusty blue
			"#d64062", // Rose berry
			"#f4c042", // Bright yellow
			"#9d72cf", // Lavender plum
			"#fffdf8", // Cream highlight
		];

		const shapes = ["rect", "circle", "star", "ribbon"];

		interface ConfettiParticle {
			x: number;
			y: number;
			vx: number;
			vy: number;
			size: number;
			color: string;
			shape: string;
			rotation: number;
			rotSpeed: number;
			tilt: number;
			tiltSpeed: number;
			opacity: number;
			decay: number;
			gravity: number;
			drag: number;
		}

		let particles: ConfettiParticle[] = [];
		let animationFrameId: number | null = null;
		let celebrationCount = 1;

		function createParticle(x: number, y: number, angleRange: [number, number], speedRange: [number, number]): ConfettiParticle {
			const angle = angleRange[0] + Math.random() * (angleRange[1] - angleRange[0]);
			const speed = speedRange[0] + Math.random() * (speedRange[1] - speedRange[0]);
			const color = colors[Math.floor(Math.random() * colors.length)];
			const shape = shapes[Math.floor(Math.random() * shapes.length)];

			return {
				x,
				y,
				vx: Math.cos(angle) * speed,
				vy: Math.sin(angle) * speed,
				size: shape === "ribbon" ? 8 + Math.random() * 8 : 5 + Math.random() * 6,
				color,
				shape,
				rotation: Math.random() * Math.PI * 2,
				rotSpeed: (Math.random() - 0.5) * 0.25,
				tilt: Math.random() * Math.PI,
				tiltSpeed: 0.08 + Math.random() * 0.08,
				opacity: 1,
				decay: 0.003 + Math.random() * 0.005,
				gravity: 0.18 + Math.random() * 0.1,
				drag: 0.982,
			};
		}

		function launchCannonBurst(x: number, y: number, count = 45, angleMin = -Math.PI * 0.85, angleMax = -Math.PI * 0.15) {
			for (let i = 0; i < count; i++) {
				particles.push(createParticle(x, y, [angleMin, angleMax], [6, 14]));
			}
			if (!animationFrameId) {
				animate();
			}
		}

		function drawStar(ctx: CanvasRenderingContext2D, cx: number, cy: number, spikes: number, outerRadius: number, innerRadius: number) {
			let rot = (Math.PI / 2) * 3;
			let x = cx;
			let y = cy;
			const step = Math.PI / spikes;

			ctx.beginPath();
			ctx.moveTo(cx, cy - outerRadius);
			for (let i = 0; i < spikes; i++) {
				x = cx + Math.cos(rot) * outerRadius;
				y = cy + Math.sin(rot) * outerRadius;
				ctx.lineTo(x, y);
				rot += step;

				x = cx + Math.cos(rot) * innerRadius;
				y = cy + Math.sin(rot) * innerRadius;
				ctx.lineTo(x, y);
				rot += step;
			}
			ctx.lineTo(cx, cy - outerRadius);
			ctx.closePath();
			ctx.fill();
		}

		function animate() {
			if (!ctx) return;
			ctx.clearRect(0, 0, width, height);

			for (let i = particles.length - 1; i >= 0; i--) {
				const p = particles[i];

				p.vx *= p.drag;
				p.vy *= p.drag;
				p.vy += p.gravity;
				p.x += p.vx;
				p.y += p.vy;

				p.rotation += p.rotSpeed;
				p.tilt += p.tiltSpeed;
				p.opacity -= p.decay;

				if (p.opacity <= 0 || p.y > height + 30) {
					particles.splice(i, 1);
					continue;
				}

				ctx.save();
				ctx.globalAlpha = Math.max(0, p.opacity);
				ctx.fillStyle = p.color;
				ctx.translate(p.x, p.y);
				ctx.rotate(p.rotation);
				ctx.scale(1, Math.sin(p.tilt));

				if (p.shape === "rect") {
					ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 1.5);
				} else if (p.shape === "circle") {
					ctx.beginPath();
					ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
					ctx.fill();
				} else if (p.shape === "star") {
					drawStar(ctx, 0, 0, 5, p.size, p.size * 0.45);
				} else if (p.shape === "ribbon") {
					ctx.fillRect(-p.size / 3, -p.size, p.size * 0.7, p.size * 2);
				}

				ctx.restore();
			}

			if (particles.length > 0) {
				animationFrameId = requestAnimationFrame(animate);
			} else {
				animationFrameId = null;
			}
		}

		// Initial celebratory double burst upon load
		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (!prefersReducedMotion) {
			setTimeout(() => {
				launchCannonBurst(width * 0.15, height * 0.9, 35, -Math.PI * 0.65, -Math.PI * 0.15);
				launchCannonBurst(width * 0.85, height * 0.9, 35, -Math.PI * 0.85, -Math.PI * 0.35);
			}, 250);

			setTimeout(() => {
				launchCannonBurst(width * 0.5, height * 0.65, 45, -Math.PI * 0.95, -Math.PI * 0.05);
			}, 650);
		}

		function triggerCelebrationPop(originX?: number, originY?: number) {
			celebrationCount++;

			// Play button spring animation
			if (popperBtn) {
				popperBtn.classList.remove("popper-bounce");
				void popperBtn.offsetWidth;
				popperBtn.classList.add("popper-bounce");
			}

			if (launchBtn) {
				launchBtn.classList.remove("btn-pop");
				void launchBtn.offsetWidth;
				launchBtn.classList.add("btn-pop");
			}

			// Update celebration counter message
			if (counterLabel) {
				const msgs = [
					`Celebrated ${celebrationCount} times! 🎉`,
					`Celebrated ${celebrationCount} times! You're on fire! 🔥`,
					`Celebrated ${celebrationCount} times! Let's party! 🥳`,
					`Celebrated ${celebrationCount} times! Ultimate reader! ⭐`,
					`Celebrated ${celebrationCount} times! Confetti master! 🎊`,
				];
				counterLabel.textContent = msgs[(celebrationCount - 1) % msgs.length];
				counterLabel.classList.add("highlight");
				setTimeout(() => counterLabel.classList.remove("highlight"), 400);
			}

			// Floating emoji reactions
			if (reactionsContainer) {
				const emojis = ["🎉", "🎊", "✨", "🥳", "❤️", "🎈", "⭐", "+100"];
				for (let i = 0; i < 4; i++) {
					const r = document.createElement("span");
					r.className = "popper-reaction-bubble";
					r.textContent = emojis[Math.floor(Math.random() * emojis.length)];
					r.style.setProperty("--tx", `${(Math.random() - 0.5) * 60}px`);
					r.style.setProperty("--ty", `${-40 - Math.random() * 50}px`);
					reactionsContainer.appendChild(r);
					setTimeout(() => r.remove(), 900);
				}
			}

			// Fire confetti burst
			const x = originX ?? width * 0.35;
			const y = originY ?? height * 0.5;
			launchCannonBurst(x, y, 60, -Math.PI * 0.98, -Math.PI * 0.02);
		}

		if (popperBtn) {
			popperBtn.addEventListener("click", (e) => {
				const rect = canvas.getBoundingClientRect();
				triggerCelebrationPop(e.clientX - rect.left, e.clientY - rect.top);
			});
		}

		if (launchBtn) {
			launchBtn.addEventListener("click", () => {
				triggerCelebrationPop();
			});
		}

		if (card) {
			card.addEventListener("click", (e) => {
				// Don't duplicate if clicking the button directly
				if ((e.target as HTMLElement).closest("button") || (e.target as HTMLElement).closest("a")) return;
				const rect = canvas.getBoundingClientRect();
				triggerCelebrationPop(e.clientX - rect.left, e.clientY - rect.top);
			});
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", setupPartyCelebration);
	} else {
		setupPartyCelebration();
	}
	document.addEventListener("astro:page-load", setupPartyCelebration);
</script>

<style>
	.party-popper-card {
		position: relative;
		margin: 20px 0 36px;
		background: var(--paper);
		border: 1px solid var(--hairline);
		border-radius: 12px;
		padding: 28px 24px;
		overflow: hidden;
		box-shadow: 0 6px 24px -4px rgba(0, 0, 0, 0.05);
		transition: background-color 0.35s ease, border-color 0.35s ease;
	}

	.confetti-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 1;
	}

	.celebration-hero {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 28px;
	}

	/* Popper Visual & Interactive Button */
	.popper-visual-wrapper {
		position: relative;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 110px;
		height: 110px;
	}

	.popper-glow {
		position: absolute;
		inset: -10px;
		background: radial-gradient(circle, hsl(var(--theme-accent) / 0.18) 0%, transparent 70%);
		border-radius: 50%;
		pointer-events: none;
		animation: glow-pulse 3s ease-in-out infinite alternate;
	}

	@keyframes glow-pulse {
		0% {
			transform: scale(0.9);
			opacity: 0.5;
		}
		100% {
			transform: scale(1.15);
			opacity: 0.9;
		}
	}

	.popper-interactive-btn {
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
		position: relative;
		border-radius: 50%;
		outline: none;
		transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.popper-interactive-btn:hover {
		transform: scale(1.1) rotate(-5deg);
	}

	.popper-interactive-btn:focus-visible {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 6px;
	}

	.popper-bounce {
		animation: popper-recoil 0.5s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
	}

	@keyframes popper-recoil {
		0% {
			transform: scale(1) rotate(0deg);
		}
		25% {
			transform: scale(0.85) rotate(-18deg);
		}
		55% {
			transform: scale(1.22) rotate(10deg);
		}
		100% {
			transform: scale(1) rotate(0deg);
		}
	}

	.popper-svg {
		width: 105px;
		height: 105px;
		overflow: visible;
		filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.08));
	}

	/* Exploding Streamers & Burst Lines Animations */
	.burst-line {
		transform-origin: 88px 88px;
		animation: burst-glow 2s ease-in-out infinite alternate;
	}
	.b1 {
		animation-delay: 0s;
	}
	.b2 {
		animation-delay: 0.3s;
	}
	.b3 {
		animation-delay: 0.6s;
	}
	.b4 {
		animation-delay: 0.9s;
	}
	.b5 {
		animation-delay: 1.2s;
	}

	@keyframes burst-glow {
		0% {
			opacity: 0.3;
			stroke-dasharray: 2 4;
		}
		100% {
			opacity: 1;
			stroke-dasharray: 8 2;
		}
	}

	.streamer-ribbon {
		animation: ribbon-wave 2.4s ease-in-out infinite alternate;
	}
	.r1 {
		transform-origin: 85px 70px;
		animation-delay: 0.1s;
	}
	.r2 {
		transform-origin: 75px 60px;
		animation-delay: 0.4s;
	}
	.r3 {
		transform-origin: 92px 78px;
		animation-delay: 0.7s;
	}

	@keyframes ribbon-wave {
		0% {
			transform: scale(0.92) rotate(-4deg);
		}
		100% {
			transform: scale(1.08) rotate(5deg);
		}
	}

	/* Floating Confetti Bits Flutter */
	.confetti-bit {
		animation: confetti-flutter 1.8s ease-in-out infinite alternate;
	}
	.c-star {
		transform-origin: 125px 25px;
		animation: star-spin 3.5s linear infinite;
	}
	.c1 {
		animation-delay: 0.2s;
	}
	.c2 {
		animation-delay: 0.5s;
	}
	.c3 {
		animation-delay: 0.8s;
	}
	.c4 {
		animation-delay: 1.1s;
	}

	@keyframes star-spin {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(360deg);
		}
	}

	@keyframes confetti-flutter {
		0% {
			transform: translateY(0px) rotate(0deg);
		}
		100% {
			transform: translateY(-5px) rotate(15deg);
		}
	}

	/* Floating Sparkles in the background */
	.floating-sparkles {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.spark-star {
		position: absolute;
		color: hsl(var(--theme-accent));
		font-size: 14px;
		animation: sparkle-float 2.5s ease-in-out infinite alternate;
	}
	.s1 {
		top: -4px;
		left: 8px;
		animation-delay: 0s;
		font-size: 16px;
	}
	.s2 {
		top: 10px;
		right: -6px;
		animation-delay: 0.6s;
		color: #e5a93c;
	}
	.s3 {
		bottom: -2px;
		left: 12px;
		animation-delay: 1.2s;
		color: #4a7c59;
